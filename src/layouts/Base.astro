---
// Page frame shared by every page: head, icon sprite, top bar, nav, footer, auth modal, toast and
// developer panel. Page content goes in the default slot.
import "../styles/home.css";
import AuthModal from "../components/AuthModal.jsx";
import DevPanel from "../components/DevPanel.jsx";
import { BASE, SRC, STATS } from "../lib/data.js";
import { SOURCES, DEFAULT_SOURCE, creditsHtml } from "../lib/shared.js";

// `images`: the IMAGES entries for artists shown on this page (photo credits + dev panel switching).
const { title = "Cosignr", home = false, images = {} } = Astro.props;
const nav = home ? "" : BASE; // on other pages, section links point back to the home page
const credits = creditsHtml(images, DEFAULT_SOURCE);
const counts = Object.fromEntries(Object.keys(SOURCES).map(k => [k, Object.values(images).filter(img => img[k]).length]));
const meta = `sources.json · ${new Date(SRC.generatedAt).toLocaleString("en-US")}\nstats.json · ${new Date(STATS.generatedAt).toLocaleString("en-US")}`;
---
<!DOCTYPE html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://fonts.googleapis.com/css?family=Nunito:300,400,700,800|Roboto:400,700&display=swap" rel="stylesheet">
    <link rel="icon" href={`${BASE}images/favicon.png`}>
    <title>{title}</title>
  </head>
  <body data-base={BASE}>

    <!-- SVG icons -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2.4"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></symbol>
      <symbol id="i-check" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></symbol>
      <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></symbol>
      <symbol id="i-play" viewBox="0 0 24 24"><path d="M7 4.5v15l13-7.5z" fill="currentColor"/></symbol>
      <symbol id="i-down" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    </svg>

    <header class="topbar">
      <form class="search" id="searchForm" role="search">
        <svg class="icon"><use href="#i-search"/></svg>
        <input id="search" type="search" placeholder="Search artists, genres, cosigns…" aria-label="Search artists" autocomplete="off">
        <button type="submit">Search</button>
      </form>

      <a href={home ? "#" : BASE} class="logo" aria-label="Cosignr home">
        Cosignr
      </a>

      <div class="auth">
        <button class="btn-login" type="button" data-modal="login">Login</button>
        <button class="btn-signup" type="button" data-modal="signup">Sign Up</button>
      </div>
    </header>

    <nav>
      <ul>
        <li><a class={home ? "active" : ""} href="#" data-target="search">Find Artist</a></li>
        <li><a href={`${nav}#featured`}>Featured</a></li>
        <li><a href={`${nav}#top`}>Top</a></li>
        <li><a href={`${nav}#trending`}>Trending</a></li>
      </ul>
    </nav>

    <slot />

    <footer>
      <a href={home ? "#" : BASE} class="logo">
        Cosignr
      </a>
      <div class="links">
        <a href="#">About</a>
        <a href="#">For Artists</a>
        <a href="#">How Cosigns Work</a>
        <a href="#">Privacy</a>
      </div>
      <span>© 2026 Cosignr · Discover music through the artists you trust.</span>
      <p class="data-sources">Data: <a href="https://musicbrainz.org" target="_blank" rel="noopener">MusicBrainz</a> (CC0){" · "}<a href="https://en.wikipedia.org" target="_blank" rel="noopener">Wikipedia</a> tour articles (CC BY-SA, linked on each tour){" · "}<a href="https://www.last.fm" target="_blank" rel="noopener">Last.fm</a>{" · "}<a href="https://www.deezer.com" target="_blank" rel="noopener">Deezer</a>{" · "}<a href="https://www.ticketmaster.com" target="_blank" rel="noopener">Ticketmaster</a></p>
      <details class="credits" id="credits" hidden={!credits}>
        <summary>Photo credits</summary>
        <ul id="creditsList" set:html={credits}></ul>
      </details>
    </footer>

    <AuthModal client:load />
    <div class="toast" id="toast" role="status"></div>
    <DevPanel client:load counts={counts} total={Object.keys(images).length} meta={meta} />

    <!-- Image sources for the dev panel's image switcher (small: URLs and credits only) -->
    <script type="application/json" id="cosignr-images" set:html={JSON.stringify(images).replace(/</g, "\\u003c")}></script>
    <script>import "../scripts/site.js";</script>
  </body>
</html>
