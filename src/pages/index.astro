---
// Home page: Featured, Trending, Hot Right Now and Top Artists, built from data/*.json at build time.
import Base from "../layouts/Base.astro";
import TrendingList from "../components/TrendingList.jsx";
import HotList from "../components/HotList.jsx";
import RisingList from "../components/RisingList.jsx";
import TopList from "../components/TopList.jsx";
import { DATA, BY_ID, IMAGES, genre, hometown, chips, pageUrl, hotLists, trendingRows, trendingImages, trendingDate, risingRows, risingImages, topRows } from "../lib/data.js";
import { DEFAULT_SOURCE, GENRES, genreGroup, imageHtml, creditHtml } from "../lib/shared.js";

const img = (a, opts) => imageHtml(IMAGES[a.id], a.name, DEFAULT_SOURCE, opts);
const credit = a => creditHtml(IMAGES[a.id], DEFAULT_SOURCE);
const usedSource = a => (IMAGES[a.id][DEFAULT_SOURCE] ? DEFAULT_SOURCE : "none");

const [main, ...rest] = DATA.featured.map(f => ({ ...f, a: BY_ID[f.artist] }));

// Trending: who's big right now (TRENDING.md), from data/trending.json. Rows hold only what the list shows.
const rows = trendingRows();
const trendImages = trendingImages();
// Rising: newcomers recently cosigned by big artists (RISING.md).
const rising = risingRows();
const riseImages = risingImages();
// Most cosigned (replaces the hand-picked 2019 Top list).
const top = topRows();
const topImages = Object.fromEntries(top.map(r => [r.id, IMAGES[r.id]]));
---
<Base home images={{ ...Object.fromEntries(DATA.artists.map(a => [a.id, IMAGES[a.id]])), ...trendImages, ...riseImages, ...topImages }}>
  <!-- Genre bar (Julian, 2026-10-16): filters Trending, Hot Right Now and Top. Not sticky; Featured stays as is. -->
  <div class="genre-bar" role="toolbar" aria-label="Filter by genre">
    <button type="button" class="active" data-genre="" aria-pressed="true">All</button>
    {GENRES.map(g => <button type="button" data-genre={g.id} aria-pressed="false">{g.label}</button>)}
  </div>

  <main class="main">
    <div class="section-head" id="featured">
      <div>
        <h2>Featured Artists</h2>
        <p>Hand-picked this week by the Cosignr community.</p>
      </div>
    </div>

    <div class="gallery" id="gallery">
      {[main].map(f => (
        <article class="tile left" data-src={usedSource(f.a)} data-img={f.a.id} data-focus="center 25%">
          <Fragment set:html={img(f.a, { focus: "center 25%" })} />
          <a class="tile-link" href={pageUrl(f.a.id)} aria-label={`${f.a.name}: artist page`}></a>
          <span class="badge">{f.label}</span>
          <div class="overlay">
            <h3><a class="artist-link" href={pageUrl(f.a.id)}>{f.a.name}</a></h3>
            <p>{[f.a.genre, hometown(f.a)].filter(Boolean).join(" · ")}</p>
            <div class="mini-chips">
              {chips(f.a, 3).length
                ? chips(f.a, 3).map((c, i) => c.href
                    ? <a class={`chip${i === 0 ? " top" : ""}`} title={c.title} href={c.href}>{c.name}</a>
                    : <span class={`chip${i === 0 ? " top" : ""}`} title={c.title}>{c.name}</span>)
                : <span class="no-cosigns">No cosigns found yet</span>}
            </div>
          </div>
          <a class="play" href={`https://open.spotify.com/artist/${f.a.ids.spotify}`} target="_blank" rel="noopener" aria-label={`Listen to ${f.a.name} on Spotify`}><svg class="icon"><use href="#i-play"/></svg></a>
          <Fragment set:html={credit(f.a).replace(/^<(a|span) /, `<$1 data-credit="${f.a.id}" `) || `<span hidden data-credit="${f.a.id}"></span>`} />
        </article>
      ))}
      <div class="right">
        {rest.map(f => (
          <article class="tile" data-src={usedSource(f.a)} data-img={f.a.id} data-focus="center 25%">
            <Fragment set:html={img(f.a, { focus: "center 25%" })} />
            <a class="tile-link" href={pageUrl(f.a.id)} aria-label={`${f.a.name}: artist page`}></a>
            <span class="badge">{f.label}</span>
            <div class="overlay">
              <h3><a class="artist-link" href={pageUrl(f.a.id)}>{f.a.name}</a></h3>
              <p>{[f.a.genre, hometown(f.a)].filter(Boolean).join(" · ")}</p>
            </div>
            <a class="play" href={`https://open.spotify.com/artist/${f.a.ids.spotify}`} target="_blank" rel="noopener" aria-label={`Listen to ${f.a.name} on Spotify`}><svg class="icon"><use href="#i-play"/></svg></a>
            <Fragment set:html={credit(f.a).replace(/^<(a|span) /, `<$1 data-credit="${f.a.id}" `) || `<span hidden data-credit="${f.a.id}"></span>`} />
          </article>
        ))}
      </div>
    </div>

    <TrendingList client:load rows={rows} images={trendImages} date={trendingDate()} />

    <!-- Rising: under Trending, above Hot Right Now (Julian, 2026-10-19). -->
    {rising.length > 0 && <RisingList client:load rows={rising} images={riseImages} />}

    <!-- Under Trending, above Top Artists (Julian, 2026-10-16). Hidden if there's no chart data at all. -->
    <HotList client:load {...hotLists()} />
  </main>

  <!-- Most cosigned (Julian, 2026-10-19): real counts, 3 per genre, All time / This year. -->
  <TopList client:load rows={top} images={topImages} />
</Base>
